# Chép file này thành .env rồi dán khóa vào. Tất cả đều lấy MIỄN PHÍ, không cần thẻ.
# Để trống dòng nào thì nhà đó bị bỏ qua (Pollinations không cần khóa vẫn chạy).

# Google AI Studio: https://aistudio.google.com/apikey  (KHÔNG bật billing)
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys  (KHÔNG nạp tiền; chỉ dùng model :free)
OPENROUTER_API_KEY=
